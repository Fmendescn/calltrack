# PostgreSQL connection string used by Prisma (e.g. postgresql://user:pass@localhost:5432/caltrack)
DATABASE_URL=

# Secret key used to sign and verify JWT access/refresh tokens
JWT_SECRET=

# OAuth 2.0 client ID for "Sign in with Google"
GOOGLE_CLIENT_ID=

# OAuth 2.0 client ID for "Sign in with Apple"
APPLE_CLIENT_ID=

# Apple Developer Team ID, used to generate the Apple client secret JWT
APPLE_TEAM_ID=

# Key ID of the private key used to sign the Apple client secret JWT
APPLE_KEY_ID=

# Apple private key (.p8 contents) used to sign the Apple client secret JWT
APPLE_PRIVATE_KEY=
